    <!-- Welcome -->
    <string name="welcome_title">There’s too much to watch. So nothing gets watched.</string>
    <string name="welcome_sub">Every film, series, album, book and comic ever made, one tap away, and an evening lost scrolling through them. Films used to be loved because there were few: a Friday walk to the rental store, one tape chosen, two days to bring it back. This is that store, and its shelves are your own list.</string>
    <string name="rules_title">House rules</string>
    <string name="rule_two">Two tapes at a time</string>
    <string name="rule_two_sub">Bring one back to take another. Nothing hangs about half‑watched.</string>
    <string name="rule_due">Due back</string>
    <string name="rule_due_sub">A film or an album for two evenings, a comic for three days, a series for a week, a book for two weeks. Rewind it before it goes back, and write three words on the slip.</string>
    <string name="rule_hours">Evening hours</string>
    <string name="rule_hours_sub">Open from 6 pm on weekdays and from noon at the weekend, until 11. No choosing at three in the morning.</string>
    <string name="rule_window">New in the window</string>
    <string name="rule_window_sub">A new tape waits a few days behind the glass before it reaches the shelf. If you still want it then, it was yours.</string>
    <string name="rule_wrapped">Wrapped in brown paper</string>
    <string name="rule_wrapped_sub">Can’t choose? Tell the clerk how much time you have and get a tape you can’t see.</string>
    <string name="rule_bin">The bargain bin</string>
    <string name="rule_bin_sub">Boxes nobody takes fade in the sun. The clerk offers to mark them down, guilt‑free; from the bin they can still be rescued.</string>
    <string name="open_store">Open the store</string>
    <string name="welcome_free">Free, no ads, no account. Your list stays on the phone.</string>

